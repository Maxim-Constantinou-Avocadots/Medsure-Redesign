---
import Page, { metadata } from "@/app/careers/page";
import Layout from "@/layouts/Layout.astro";
import { formIds } from "@/content/form-ids";
import { getForm } from "@/wix/forms/forms";

const initialForm = await getForm(formIds.careers).catch((error) => {
  console.error("Could not load Medsure careers form:", error);
  return undefined;
});
---
<Layout {metadata}>
  <Page {initialForm} client:load />
</Layout>
